{
  "hi": [
    {
      "id": "HI-TTS-01",
      "text": "नमस्ते, आप कैसे हैं?"
    },
    {
      "id": "HI-TTS-02",
      "text": "कृपया तुरंत बचाव दल भेजें।"
    },
    {
      "id": "HI-TTS-03",
      "text": "अस्पताल यहाँ से पाँच किलोमीटर दूर है।"
    },
    {
      "id": "HI-TTS-04",
      "text": "यहाँ सौ से ज्यादा लोग फँसे हैं।"
    },
    {
      "id": "HI-TTS-05",
      "text": "तुरंत खाली करें।"
    },
    {
      "id": "HI-TTS-06",
      "text": "खाली मत करें।"
    },
    {
      "id": "HI-TTS-07",
      "text": "सड़क खुली है।"
    },
    {
      "id": "HI-TTS-08",
      "text": "मरीज होश में है।"
    },
    {
      "id": "HI-TTS-09",
      "text": "आग पर नियंत्रण है।"
    },
    {
      "id": "HI-TTS-10",
      "text": "मेडिकल टीम सुरक्षित स्थान पर पहुँच गई है।"
    }
  ],
  "en": [
    {
      "id": "EN-TTS-01",
      "text": "Hello, how are you today?"
    },
    {
      "id": "EN-TTS-02",
      "text": "Please dispatch the rescue team immediately."
    },
    {
      "id": "EN-TTS-03",
      "text": "The hospital is five kilometers away from here."
    },
    {
      "id": "EN-TTS-04",
      "text": "More than one hundred people are stranded here."
    },
    {
      "id": "EN-TTS-05",
      "text": "Evacuate immediately."
    },
    {
      "id": "EN-TTS-06",
      "text": "Do not evacuate."
    },
    {
      "id": "EN-TTS-07",
      "text": "Road is open."
    },
    {
      "id": "EN-TTS-08",
      "text": "Patient is conscious."
    },
    {
      "id": "EN-TTS-09",
      "text": "Fire is controlled."
    },
    {
      "id": "EN-TTS-10",
      "text": "The medical team has arrived safely."
    }
  ],
  "bn": [
    {
      "id": "BN-TTS-01",
      "text": "নমস্কার, আপনি কেমন আছেন?"
    },
    {
      "id": "BN-TTS-02",
      "text": "দয়া করে অবিলম্বে উদ্ধারকারী দল পাঠান।"
    },
    {
      "id": "BN-TTS-03",
      "text": "হাসপাতাল এখান থেকে পাঁচ কিলোমিটার দূরে।"
    },
    {
      "id": "BN-TTS-04",
      "text": "এখানে একশোর বেশি মানুষ আটকে আছেন।"
    },
    {
      "id": "BN-TTS-05",
      "text": "অবিলম্বে খালি করুন।"
    },
    {
      "id": "BN-TTS-06",
      "text": "খালি করবেন না।"
    },
    {
      "id": "BN-TTS-07",
      "text": "রাস্তা খোলা আছে।"
    },
    {
      "id": "BN-TTS-08",
      "text": "রোগী সচেতন আছেন।"
    },
    {
      "id": "BN-TTS-09",
      "text": "আগুন নিয়ন্ত্রণে আছে।"
    },
    {
      "id": "BN-TTS-10",
      "text": "মেডিকেল টিম নিরাপদ আশ্রয়ে পৌঁছেছে।"
    }
  ],
  "gu": [
    {
      "id": "GU-TTS-01",
      "text": "નમસ્તે, તમે કેમ છો?"
    },
    {
      "id": "GU-TTS-02",
      "text": "કૃપા કરીને તરત જ બચાવ ટીમ મોકલો."
    },
    {
      "id": "GU-TTS-03",
      "text": "હોસ્પિટલ અહીંથી પાંચ કિલોમીટર દૂર છે."
    },
    {
      "id": "GU-TTS-04",
      "text": "અહીં સોથી વધુ લોકો ફસાયેલા છે."
    },
    {
      "id": "GU-TTS-05",
      "text": "તરત જ ખાલી કરો."
    },
    {
      "id": "GU-TTS-06",
      "text": "ખાલી કરશો નહીં."
    },
    {
      "id": "GU-TTS-07",
      "text": "રસ્તો ખુલ્લો છે."
    },
    {
      "id": "GU-TTS-08",
      "text": "દર્દી ભાનમાં છે."
    },
    {
      "id": "GU-TTS-09",
      "text": "આગ કાબૂમાં છે."
    },
    {
      "id": "GU-TTS-10",
      "text": "મેડિકલ ટીમ સુરક્ષિત સ્થળે પહોંચી ગઈ છે."
    }
  ],
  "mr": [
    {
      "id": "MR-TTS-01",
      "text": "नमस्कार, आपण कसे आहात?"
    },
    {
      "id": "MR-TTS-02",
      "text": "कृपया त्वरित बचाव पथक पाठवा."
    },
    {
      "id": "MR-TTS-03",
      "text": "रुग्णालय येथून पाच किलोमीटर अंतरावर आहे."
    },
    {
      "id": "MR-TTS-04",
      "text": "येथे शंभरहून अधिक लोक अडकले आहेत."
    },
    {
      "id": "MR-TTS-05",
      "text": "ताबडतोब रिकामे करा."
    },
    {
      "id": "MR-TTS-06",
      "text": "रिकामे करू नका."
    },
    {
      "id": "MR-TTS-07",
      "text": "रस्ता उघडा आहे."
    },
    {
      "id": "MR-TTS-08",
      "text": "रुग्ण शुद्धीवर आहे."
    },
    {
      "id": "MR-TTS-09",
      "text": "आग नियंत्रणात आहे."
    },
    {
      "id": "MR-TTS-10",
      "text": "वैद्यकीय पथक सुरक्षित ठिकाणी पोहोचले आहे."
    }
  ],
  "kn": [
    {
      "id": "KN-TTS-01",
      "text": "ನಮಸ್ಕಾರ, ನೀವು ಹೇಗಿದ್ದೀರಿ?"
    },
    {
      "id": "KN-TTS-02",
      "text": "ದಯವಿಟ್ಟು ತಕ್ಷಣ ರಕ್ಷಣಾ ತಂಡವನ್ನು ಕಳುಹಿಸಿ."
    },
    {
      "id": "KN-TTS-03",
      "text": "ಆಸ್ಪತ್ರೆ ಇಲ್ಲಿಂದ ಐದು ಕಿಲೋಮೀಟರ್ ದೂರದಲ್ಲಿದೆ."
    },
    {
      "id": "KN-TTS-04",
      "text": "ಇಲ್ಲಿ ನೂರಕ್ಕೂ ಹೆಚ್ಚು ಜನರು ಸಿಲುಕಿಕೊಂಡಿದ್ದಾರೆ."
    },
    {
      "id": "KN-TTS-05",
      "text": "ತಕ್ಷಣ ಖಾಲಿ ಮಾಡಿ."
    },
    {
      "id": "KN-TTS-06",
      "text": "ಖಾಲಿ ಮಾಡಬೇಡಿ."
    },
    {
      "id": "KN-TTS-07",
      "text": "ರಸ್ತೆ ತೆರೆದಿದೆ."
    },
    {
      "id": "KN-TTS-08",
      "text": "ರೋಗಿ ಪ್ರಜ್ಞೆಯಲ್ಲಿದ್ದಾರೆ."
    },
    {
      "id": "KN-TTS-09",
      "text": "ಬೆಂಕಿ ನಿಯಂತ್ರಣದಲ್ಲಿದೆ."
    },
    {
      "id": "KN-TTS-10",
      "text": "ವೈದ್ಯಕೀಯ ತಂಡ ಸುರಕ್ಷಿತ ಸ್ಥಳವನ್ನು ತಲುಪಿದೆ."
    }
  ],
  "ml": [
    {
      "id": "ML-TTS-01",
      "text": "നമസ്കാരം, സുഖമാണോ?"
    },
    {
      "id": "ML-TTS-02",
      "text": "ദയവായി ഉടൻ രക്ഷാപ്രവർത്തകരെ അയക്കുക."
    },
    {
      "id": "ML-TTS-03",
      "text": "ആശുപത്രി ഇവിടെ നിന്ന് അഞ്ച് കിലോമീറ്റർ അകലെയാണ്."
    },
    {
      "id": "ML-TTS-04",
      "text": "ഇവിടെ നൂറിലധികം ആളുകൾ കുടുങ്ങിക്കിടക്കുന്നു."
    },
    {
      "id": "ML-TTS-05",
      "text": "ഉടൻ ഒഴിഞ്ഞുപോകുക."
    },
    {
      "id": "ML-TTS-06",
      "text": "ഒഴിഞ്ഞുപോകരുത്."
    },
    {
      "id": "ML-TTS-07",
      "text": "റോഡ് തുറന്നിരിക്കുന്നു."
    },
    {
      "id": "ML-TTS-08",
      "text": "രോഗിക്ക് ബോധമുണ്ട്."
    },
    {
      "id": "ML-TTS-09",
      "text": "തീ നിയന്ത്രണവിധേയമാണ്."
    },
    {
      "id": "ML-TTS-10",
      "text": "മെഡിക്കൽ ടീം സുരക്ഷിതമായി എത്തിച്ചേർന്നു."
    }
  ],
  "ta": [
    {
      "id": "TA-TTS-01",
      "text": "வணக்கம், நீங்கள் எப்படி இருக்கிறீர்கள்?"
    },
    {
      "id": "TA-TTS-02",
      "text": "தயவுசெய்து உடனடியாக மீட்புக் குழுவை அனுப்பவும்."
    },
    {
      "id": "TA-TTS-03",
      "text": "மருத்துவமனை இங்கிருந்து ஐந்து கிலோமீட்டர் தொலைவில் உள்ளது."
    },
    {
      "id": "TA-TTS-04",
      "text": "இங்கு நூற்றுக்கும் மேற்பட்டோர் சிக்கியுள்ளனர்."
    },
    {
      "id": "TA-TTS-05",
      "text": "உடனடியாக வெளியேறவும்."
    },
    {
      "id": "TA-TTS-06",
      "text": "வெளியேற வேண்டாம்."
    },
    {
      "id": "TA-TTS-07",
      "text": "சாலை திறக்கப்பட்டுள்ளது."
    },
    {
      "id": "TA-TTS-08",
      "text": "நோயாளி சுயநினைவுடன் உள்ளார்."
    },
    {
      "id": "TA-TTS-09",
      "text": "தீ கட்டுக்குள் உள்ளது."
    },
    {
      "id": "TA-TTS-10",
      "text": "மருத்துவக் குழு பாதுகாப்பாக வந்து சேர்ந்தது."
    }
  ],
  "te": [
    {
      "id": "TE-TTS-01",
      "text": "నమస్కారం, మీరు ఎలా ఉన్నారు?"
    },
    {
      "id": "TE-TTS-02",
      "text": "దయచేసి వెంటనే సహాయక బృందాన్ని పంపండి."
    },
    {
      "id": "TE-TTS-03",
      "text": "ఆసుపత్రి ఇక్కడి నుంచి ఐదు కిలోమీటర్ల దూరంలో ఉంది."
    },
    {
      "id": "TE-TTS-04",
      "text": "ఇక్కడ వంద మందికి పైగా చిక్కుకున్నారు."
    },
    {
      "id": "TE-TTS-05",
      "text": "వెంటనే ఖాళీ చేయండి."
    },
    {
      "id": "TE-TTS-06",
      "text": "ఖాళీ చేయవద్దు."
    },
    {
      "id": "TE-TTS-07",
      "text": "రహదారి తెరిచి ఉంది."
    },
    {
      "id": "TE-TTS-08",
      "text": "రోగి స్పృహలో ఉన్నాడు."
    },
    {
      "id": "TE-TTS-09",
      "text": "మంటలు అదుపులో ఉన్నాయి."
    },
    {
      "id": "TE-TTS-10",
      "text": "వైద్య బృందం సురక్షితంగా చేరుకుంది."
    }
  ],
  "or": [
    {
      "id": "OR-TTS-01",
      "text": "ନମସ୍କାର, ଆପଣ କେମିତି ଅଛନ୍ତି?"
    },
    {
      "id": "OR-TTS-02",
      "text": "ଦୟାକରି ତୁରନ୍ତ ଉଦ୍ଧାରକାରୀ ଦଳ ପଠାନ୍ତୁ।"
    },
    {
      "id": "OR-TTS-03",
      "text": "ଡାକ୍ତରଖାନା ଏଠାରୁ ପାଞ୍ଚ କିଲୋମିଟର ଦୂରରେ ଅଛି।"
    },
    {
      "id": "OR-TTS-04",
      "text": "ଏଠାରେ ଶହେରୁ ଅଧିକ ଲୋକ ଫସି ରହିଛନ୍ତି।"
    },
    {
      "id": "OR-TTS-05",
      "text": "ତୁରନ୍ତ ଖାଲି କରନ୍ତୁ।"
    },
    {
      "id": "OR-TTS-06",
      "text": "ଖାଲି କରନ୍ତୁ ନାହିଁ।"
    },
    {
      "id": "OR-TTS-07",
      "text": "ରାସ୍ତା ଖୋଲା ଅଛି।"
    },
    {
      "id": "OR-TTS-08",
      "text": "ରୋଗୀ ଚେତନାରେ ଅଛନ୍ତି।"
    },
    {
      "id": "OR-TTS-09",
      "text": "ନିଆଁ ନିୟନ୍ତ୍ରଣରେ ଅଛି।"
    },
    {
      "id": "OR-TTS-10",
      "text": "ଡାକ୍ତରୀ ଦଳ ସୁରକ୍ଷିତ ଭାବରେ ପହଞ୍ଚିଛନ୍ତି।"
    }
  ]
}